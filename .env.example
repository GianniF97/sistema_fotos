# =============================================================================
# NICOLAS TECHEIRA FOTOGRAFÍAS — CONFIGURACIÓN DE ENTORNO
# Duplica este archivo como .env y añade tus valores reales.
# =============================================================================

# --- SERVIDOR HTTP ---
PORT=3000
NODE_ENV=development

# --- BASE DE DATOS MARIADB / MYSQL (LOCAL Y PRODUCCIÓN HOSTINGER) ---
# En entorno local con XAMPP o Docker usa 'localhost' o '127.0.0.1'.
# En Hostinger, utiliza el host provisto en el panel cPanel/hPanel (usualmente 'localhost').
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nicolas_techeira
DB_USER=nt_user
DB_PASSWORD=nt_local_secure_pass_2026

# Límite de conexiones del pool de MariaDB
DB_CONNECTION_LIMIT=10

# Para Docker Compose (creación de usuario y root):
DB_ROOT_PASSWORD=root_master_pass_2026

# --- SEGURIDAD Y ADMINISTRACIÓN DEL ESTUDIO ---
ADMIN_SESSION_SECRET=nicolas_techeira_estudio_secret_token_2026
ADMIN_PASSWORD_SALT=nicolas_techeira_salt_2026

# --- PASARELA DE PAGO (MERCADOPAGO) ---
MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_access_token
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_firmas_aqui
# Modo simulado: solo habilitar en desarrollo si no cuentas con credenciales reales. Nunca usar en producción.
ALLOW_SIMULATED_PAYMENTS=false

# --- ALMACENAMIENTO DE FOTOGRAFÍAS (STORAGE) ---
# Ruta local para originales privados (fuera del directorio público frontend/)
STORAGE_DIR=storage/originals

# --- CONTACTO OFICIAL / WHATSAPP ---
WHATSAPP_NUMBER=5493755284134

