# =============================================================================
# NICOLAS TECHEIRA FOTOGRAFÍAS — VARIABLES DE ENTORNO (EJEMPLO)
# Duplica este archivo como .env y añade tus valores de configuración reales.
# =============================================================================

# --- SUPABASE CONFIGURATION (PÚBLICO / FRONTEND) ---
# URL de tu proyecto de Supabase (ej: https://asuepmdkhuetkndxsaaf.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública / anon de Supabase (segura para exponer en el navegador mediante RLS)
SUPABASE_KEY=tu_supabase_anon_publishable_key

# --- CONTRASEÑA ADMINISTRADOR (CMS) ---
ADMIN_PASSWORD=tu_hash_o_password_admin

# --- MERCADOPAGO (PASARELA DE PAGO) ---
MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_access_token

# --- SERVIDOR HTTP Y ENTORNO ---
PORT=3000
NODE_ENV=development
