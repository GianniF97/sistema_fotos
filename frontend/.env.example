# =============================================================================
# NICOLAS TECHEIRA FOTOGRAFÍAS — VARIABLES DE ENTORNO (EJEMPLO)
# Duplica este archivo como .env y añade tus valores de configuración reales.
# =============================================================================

# --- SUPABASE CONFIGURATION (PÚBLICO / FRONTEND) ---
# URL de tu proyecto de Supabase (ej: https://asuepmdkhuetkndxsaaf.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública / anon de Supabase (segura para exponer en el navegador mediante RLS)
SUPABASE_KEY=tu_supabase_anon_publishable_key

# --- SUPABASE CONFIGURATION (PRIVADO / SOLO BACKEND - NUNCA EXPONER EN FRONTEND) ---
# Clave service_role: solo para migraciones, scripts de mantenimiento o backend seguro
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_backend

# Token de acceso de Supabase CLI para migraciones automáticas (opcional)
SUPABASE_ACCESS_TOKEN=tu_supabase_access_token

# URL de conexión directa PostgreSQL para migraciones CLI (opcional)
# Formato: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# --- MERCADOPAGO (PASARELA DE PAGO OPCIONAL) ---
MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_access_token

# --- SERVIDOR HTTP Y ENTORNO ---
PORT=3000
NODE_ENV=development
