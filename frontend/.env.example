# Archivo de ejemplo de configuración para el entorno Picsel / PixelFlow
# Duplica este archivo como .env y añade tus claves reales para producción.

# --- SUPABASE DATABASE & AUTH ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_backend

# --- CLOUDFLARE R2 OBJECT STORAGE (FOTOGRAFÍAS EN ALTA RESOLUCIÓN) ---
CLOUDFLARE_ACCOUNT_ID=tu_account_id_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET_NAME=sistema-fotos
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# --- MERCADOPAGO (PASARELA DE PAGO) ---
MERCADOPAGO_PUBLIC_KEY=TEST-tu_public_key
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_access_token

# --- SERVIDOR Y SEGURIDAD ---
ADMIN_DEFAULT_EMAIL=admin@picsel.app
PORT=3000
NODE_ENV=development
