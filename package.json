{
  "name": "nicolas-techeira-fotografias",
  "version": "1.0.0",
  "description": "Plataforma fotográfica editorial y CMS de Nicolas Techeira con persistencia en MariaDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --import ./tests/setup-env.mjs --test tests/*.test.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js"
  },
  "keywords": [
    "fotografia",
    "portfolio",
    "mariadb",
    "mysql",
    "hostinger",
    "cms"
  ],
  "author": "Nicolas Techeira",
  "license": "ISC",
  "dependencies": {
    "dotenv": "18.0.9",
    "hono": "4.13.13",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
